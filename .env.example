PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
CORS_ORIGIN=*
MAX_UPLOAD_MB=30

# Optional AI relighting bridge (ComfyUI).
# Leave blank to keep the app in Manual + Prompt mode.
COMFYUI_URL=http://127.0.0.1:8188
# Set to "true" only after a compatible ComfyUI workflow is installed and mapped.
COMFYUI_ENABLED=false

# Never put secrets in public/index.html or commit .env.
